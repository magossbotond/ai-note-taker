# Copy this file to .env and fill in real values. .env is gitignored.

# Cloud transcription API (if not using local whisper.cpp)
CLOUD_STT_API_KEY=

# Cloud LLM API (if not using local Ollama)
CLOUD_LLM_API_KEY=

# Local Ollama server
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Path to local whisper.cpp executable and model
WHISPER_CPP_BIN=bin/whisper/main.exe
WHISPER_CPP_MODEL=bin/whisper/ggml-base.en.bin
